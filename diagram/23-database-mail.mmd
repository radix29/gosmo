classDiagram

    %% =========================================================
    %% Database Mail — msdb.dbo.sysmail_* (database_mail.go reads,
    %% database_mail_write.go writes, scripter_database_mail.go scripts)
    %% =========================================================

    class Mail {
        <<facet>>
        +Server() *Server
        +Accounts() []*MailAccount
        +AccountByName(name) *MailAccount
        +AccountRef(name) *MailAccount
        +CreateAccount(req) *MailAccount
        +Profiles() []*MailProfile
        +ProfileByName(name) *MailProfile
        +ProfileRef(name) *MailProfile
        +CreateProfile(req) *MailProfile
        +PrincipalProfiles() []*MailPrincipalProfile
        +Configuration() *MailConfiguration
        +SetConfiguration(opts) error
        +Status() MailState
        +Start() error
        +Stop() error
        +Queues() []*MailQueue
        +Visibility() MailVisibility
        +Items(filter) []*MailItem
        +ItemByID(id) *MailItem
        +DeleteItems(before, status) error
        +Events(filter) []*MailEvent
        +DeleteLog(before, eventType) error
        +Send(MailMessage) int
    }

    class MailAccount {
        -server *Server
        +AccountID int
        +Name string
        +Description string
        +EmailAddress string
        +DisplayName string
        +ReplyToAddress string
        +ServerType string
        +ServerName string
        +Port int
        +EnableSSL bool
        +UserName string
        +CredentialID int
        +UseDefaultCredentials bool
        +Timeout int
        +LastModified time.Time
        +Server() *Server
        +Authentication() MailAuthentication
        +Alter(ctx, MailAccountOptions) error
        +Drop(ctx) error
        No password field: it is a server credential.
    }

    class MailCredentials {
        +Authentication MailAuthentication
        +UserName string
        +Password string
        Write-only; scripts carry <password>.
    }

    class MailProfile {
        -server *Server
        +ProfileID int
        +Name string
        +Description string
        +IsPublic bool
        +IsDefault bool
        +Accounts []*MailProfileAccount
        +LastModified time.Time
        +Server() *Server
        +Alter(ctx, MailProfileOptions) error
        +Drop(ctx) error
        +SetAccounts(ctx, []string) error
        +AddAccount / RemoveAccount / SetAccountSequence
        +Grant / SetGrantDefault(principal, def MailProfileDefault) / Revoke
    }

    class MailProfileAccount {
        +AccountID int
        +AccountName string
        +SequenceNumber int
    }

    class MailPrincipalProfile {
        +ProfileID int
        +ProfileName string
        +PrincipalSID []byte
        +PrincipalName string
        +IsDefault bool
        +IsPublic() bool
        SID 0x00 is public, named here, not guest.
    }

    class MailConfiguration {
        +AccountRetryAttempts int
        +AccountRetryDelay int
        +DatabaseMailExeMinimumLifeTime int
        +DefaultAttachmentEncoding string
        +LoggingLevel MailLoggingLevel
        +MaxFileSize int
        +ProhibitedExtensions string
    }

    class MailState {
        <<enumeration>>
        MailDisabled
        MailStopped
        MailStarted
    }

    class MailQueue {
        +Type string
        +Length int
        +State string
        +LastEmptyRowset time.Time
        +LastActivated time.Time
        Needs VIEW SERVER STATE.
    }

    class MailItem {
        +MailItemID int
        +ProfileID int
        +Recipients string
        +Subject string
        +Body string
        +SendRequestDate time.Time
        +SentStatus MailSentStatus
        +SentDate time.Time
        and the other sysmail_allitems columns
    }

    class MailEvent {
        +LogID int
        +EventType MailEventType
        +LogDate time.Time
        +Description string
        +MailItemID int
        +AccountID int
    }

    Server --> Mail : Mail()
    Mail "1" --> "*" MailAccount : Accounts / AccountByName
    Mail "1" --> "*" MailProfile : Profiles / ProfileByName
    MailProfile *-- MailProfileAccount : Accounts
    MailProfileAccount --> MailAccount : AccountID
    Mail "1" --> "*" MailPrincipalProfile : PrincipalProfiles
    MailPrincipalProfile --> MailProfile : ProfileID
    Mail ..> MailConfiguration : Configuration
    Mail ..> MailState : Status
    Mail ..> MailQueue : Queues
    Mail ..> MailItem : Items(MailItemFilter) / ItemByID
    Mail ..> MailEvent : Events(MailEventFilter)
    MailEvent --> MailItem : MailItemID
    Mail ..> MailAccount : CreateAccount / AccountRef
    Mail ..> MailProfile : CreateProfile / ProfileRef
    MailAccount ..> MailCredentials : CreateMailAccountRequest / MailAccountOptions
    Mail ..> MailConfiguration : SetConfiguration(MailConfigurationOptions)
    Mail ..> MailState : Start / Stop
    Mail ..> MailItem : Send(MailMessage) → mailitem_id / DeleteItems
    Mail ..> MailEvent : DeleteLog
    Server ..> MailEvent : ReadLog(ErrorLogDatabaseMail)
