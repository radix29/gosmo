    %% =========================================================
    %% Relationships
    %% =========================================================
    Server "1" --> "*" Database : owns
    DatabaseSnapshot --> Database : Database() opens
    ScriptCollector ..> Database : captures writes from
    Scripter --> Database : scripts objects from
