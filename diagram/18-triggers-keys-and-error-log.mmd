classDiagram

    %% =========================================================
    %% Server audits, audit specifications, server triggers
    %% =========================================================

    class DatabaseTrigger {
        -db *Database
        +Name string
        +IsEnabled bool
        +CreateDate time.Time
        +ModifyDate time.Time
        +Events []string
        +Definition string
        +Database() *Database
        +Enable() error
        +Disable() error
        +Drop() error
        The parent_class = 0 family: DDL triggers on
        the database itself. DISABLE TRIGGER takes
        ON DATABASE here, not ON ALL SERVER.
    }

    %% =========================================================
    %% Certificates and the database master key
    %% =========================================================

    class AsymmetricKey {
        +Name string
        +KeyID int
        +PrincipalID int
        +Algorithm string
        +KeyLength int
        +PvtKeyEncryptionType string
        +Thumbprint []byte
        +Owner string
        +ProviderType string
        +AttestedBy string
        +Database() *Database
        +HasPrivateKey() bool
        +RemovePrivateKey() error
        +ChangeOwner(newOwner) error
        +SignedModules() []*ModuleSignature
        +Drop() error
    }

    class Certificate {
        -db *Database
        +Name string
        +CertificateID int
        +PrincipalID int
        +Subject string
        +PvtKeyEncryptionType string
        +StartDate time.Time
        +ExpiryDate time.Time
        +Thumbprint []byte
        +Owner string
        +IssuerName string
        +SerialNumber string
        +KeyLength int
        +IsActiveForBeginDialog bool
        +PvtKeyLastBackupDate time.Time
        +AttestedBy string
        +Database() *Database
        +HasPrivateKey() bool
        +Encoded() []byte
        +Backup(spec) error
        +RemovePrivateKey() error
        +ChangeOwner(newOwner) error
        +SignedModules() []*ModuleSignature
        +Drop() error
    }

    class CreateCertificateRequest {
        +Name string
        +Authorization string
        +Subject string
        +StartDate time.Time
        +ExpiryDate time.Time
        +EncryptionPassword string
        +FromBinary []byte
    }

    class SymmetricKey {
        +Name string
        +KeyID int
        +PrincipalID int
        +Owner string
        +Algorithm string
        +KeyLength int
        +KeyGUID string
        +CreateDate time.Time
        +ModifyDate time.Time
        +ProviderType string
        +Encryptions []SymmetricKeyEncryption
        +Database() *Database
        +AddEncryption(enc, dec) error
        +DropEncryption(enc, dec) error
        +ChangeOwner(newOwner) error
        +Drop() error
    }

    class SymmetricKeyEncryption {
        +Kind SymmetricKeyEncryptionKind
        +Name string
        +CryptTypeDesc string
        +Thumbprint []byte
    }

    class SymmetricKeyEncryptionKind {
        <<enumeration>>
        CERTIFICATE
        ASYMMETRIC KEY
        SYMMETRIC KEY
        PASSWORD
        MASTER KEY
    }

    class SymmetricKeyAlgorithm {
        <<enumeration>>
        AES_128
        AES_192
        AES_256
        DES / TRIPLE_DES / TRIPLE_DES_3KEY
        RC2 / RC4 / RC4_128 / DESX
    }

    class CreateSymmetricKeyRequest {
        +Name string
        +Authorization string
        +Algorithm SymmetricKeyAlgorithm
        +KeySource string
        +IdentityValue string
        +Encryptions []SymmetricKeyEncryptor
        +FromProvider *ProviderKey
    }

    class SymmetricKeyEncryptor {
        +Kind SymmetricKeyEncryptionKind
        +Name string
        +Password string
        +Open *SymmetricKeyDecryptor
    }

    class SymmetricKeyDecryptor {
        +Kind SymmetricKeyEncryptionKind
        +Name string
        +Password string
        +Open *SymmetricKeyDecryptor
    }

    class CreateAsymmetricKeyRequest {
        +Name string
        +Authorization string
        +Algorithm AsymmetricKeyAlgorithm
        +EncryptionPassword string
        +FromProvider *ProviderKey
    }

    class AsymmetricKeyAlgorithm {
        <<enumeration>>
        RSA_512
        RSA_1024
        RSA_2048
        RSA_3072
        RSA_4096
    }

    %% =========================================================
    %% Error log
    %% =========================================================

    class ErrorLogType {
        <<enumeration>>
        ErrorLogSQLServer
        ErrorLogAgent
    }

    class ErrorLogFile {
        +Number int
        +Date string
        +LastWritten time.Time
        +SizeBytes int64
    }

    class ErrorLogEntry {
        +LogDate string
        +Process string
        +Text string
        +Date time.Time
        +ErrorLevel int
        +Source() string
    }

    class LogSearch {
        +Text1 string
        +Text2 string
        +From time.Time
        +To time.Time
        xp_readerrorlog's own arguments 3-6:
        Text1 and Text2 are case-insensitive
        substrings AND-ed together, not two
        alternatives. A zero LogSearch reads
        the whole file. Filtering at the server
        is what makes the current log usable on
        a busy instance.
    }

    %% =========================================================
    %% Server filesystem (paths the SERVER resolves, not the client)
    %% =========================================================

    class FileSystemEntry {
        +Name string
        +FullPath string
        +IsDirectory bool
        +Size int64
        +LastModified time.Time
    }

    class FixedDrive {
        +Name string
        +Type string
        +FreeSpaceBytes int64
    }

    %% =========================================================
    %% Relationships
    %% =========================================================
    Database "1" --> "*" DatabaseTrigger : owns
    Server "1" --> "*" ErrorLogFile : EnumErrorLogs() returns
    Server "1" --> "*" ErrorLogEntry : ReadLog() returns
    Server "1" --> "*" FileSystemEntry : EnumFileSystem() returns
    Server "1" --> "*" FixedDrive : FixedDrives() returns
    Server ..> ErrorLogType : selects log family with
    Server ..> LogSearch : ReadLogFiltered() narrowed by
    Database "1" --> "*" Certificate : contains
    Database "1" --> "*" AsymmetricKey : contains
    Database "1" --> "*" SymmetricKey : contains
    SymmetricKey "1" --> "*" SymmetricKeyEncryption : Encryptions
    SymmetricKeyEncryption ..> SymmetricKeyEncryptionKind : uses
    Database --> CreateSymmetricKeyRequest : CreateSymmetricKey() accepts
    CreateSymmetricKeyRequest ..> SymmetricKeyAlgorithm : uses
    CreateSymmetricKeyRequest "1" --> "*" SymmetricKeyEncryptor : Encryptions
    SymmetricKey ..> SymmetricKeyEncryptor : Add/DropEncryption() take
    SymmetricKey ..> SymmetricKeyDecryptor : opened by
    SymmetricKeyEncryptor ..> SymmetricKeyDecryptor : Open
    Database --> CreateCertificateRequest : CreateCertificate() accepts
    Database --> CreateAsymmetricKeyRequest : CreateAsymmetricKey() accepts
    CreateAsymmetricKeyRequest ..> AsymmetricKeyAlgorithm : uses
