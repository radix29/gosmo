classDiagram

    %% =========================================================
    %% Replication, read-only (replication.go,
    %% replication_subscription.go, replication_monitor.go): the
    %% distributor and publisher configuration, publications with their
    %% articles and subscriptions, the subscriptions held here, and the
    %% Replication Monitor reads at a distributor
    %% =========================================================

    class ReplicationInfo {
        +DistributorConfigured bool
        +Distributor string
        +IsDistributor bool
        +IsPublisher bool
        +DistributionDatabases []DistributionDatabase
        +Publishers []DistributionPublisher
        +Databases []ReplicationDatabase
        +DistributorDetailsHidden bool
        Zero, not an error, with nothing configured.
    }

    class DistributionDatabase {
        -srv *Server
        +Name string
        +MinRetentionHours int
        +MaxRetentionHours int
        +HistoryRetentionHours int
        +Server() *Server
        +CanMonitor() bool
        +MonitorPublications() []MonitorPublication
        +MonitorSubscriptions() []MonitorSubscription
        +Agents() []*ReplicationAgent
        +Errors(id) []ReplicationError
    }

    class MonitorPublisher {
        +Name string
        +DistributionDB string
        +Status ReplAgentStatus
        +Warning MonitorWarning
        +PublicationCount int
    }

    class MonitorPublication {
        +Publisher string
        +PublisherDB string
        +Publication string
        +Type PublicationType
        +Status ReplAgentStatus
        +Warning MonitorWarning
        +WorstLatency *int
        +SnapshotAgent string
        +LogReaderAgent string
        and latency, thresholds, run speed
    }

    class MonitorSubscription {
        +Subscriber string
        +SubscriberDB string
        +Publication string
        +Type SubscriptionType
        +Status ReplAgentStatus
        +Warning MonitorWarning
        +Latency *int
        +DistributionAgent string
        +MergeAgent string
        and expiration, merge performance
    }

    class ReplicationAgent {
        -dd *DistributionDatabase
        +Kind ReplAgentKind
        +Name string
        +Publisher string
        +Publication string
        +Subscriber string
        +Status ReplAgentStatus
        +LastStart time.Time
        +LastAction string
        +ErrorID int
        and delivery figures
        +DistributionDatabase() *DistributionDatabase
        +Sessions(hours, errorsOnly) []ReplAgentSession
        +SessionActions(session) []ReplAgentAction
    }

    class ReplAgentSession {
        +Status ReplAgentStatus
        +Start time.Time
        +End time.Time
        +LastAction string
        +ErrorID int
    }

    class ReplAgentAction {
        +Status ReplAgentStatus
        +Time time.Time
        +Message string
        +ErrorID int
    }

    class ReplicationError {
        +Time time.Time
        +SourceName string
        +Code string
        +Text string
        +XactSeqno string
        +CommandID int
    }

    class ReplAgentStatus {
        <<enumeration>>
        NeverRun
        Started
        Succeeded
        InProgress
        Idle
        Retrying
        Failed
    }

    class MonitorWarning {
        +Warnings() []string
    }

    class DistributionPublisher {
        +Name string
        +DistributionDatabase string
        +WorkingDirectory string
        +WindowsAuth bool
        +Active bool
        +PublisherType string
    }

    class ReplicationDatabase {
        +Name string
        +Published bool
        +MergePublished bool
        +Distribution bool
        +Readable bool
    }

    class Publication {
        -db *Database
        +Name string
        +Description string
        +Type PublicationType
        +Active bool
        +Retention int
        +RetentionUnit string
        +SyncMethod string
        +AllowPush bool
        +AllowPull bool
        +AllowAnonymous bool
        and the snapshot, transactional and merge options
        +Database() *Database
        +Articles() []*Article
        +Subscriptions() []*Subscription
    }

    class Article {
        -pub *Publication
        +Name string
        +Type string
        +TypeCode int
        +SchemaOnly bool
        +SourceSchema string
        +SourceObject string
        +DestinationOwner string
        +DestinationObject string
        +Filter string
        +PreCreationCommand string
        +SchemaOption SchemaOption
        +Description string
        +Publication() *Publication
    }

    class SchemaOption {
        +Options() []string
    }

    class Subscription {
        -pub *Publication
        +Subscriber string
        +SubscriberDB string
        +Type SubscriptionType
        +Status string
        +SyncType string
        merge only: SubscriberType, Priority, LastSync*
        +Publication() *Publication
    }

    class LocalSubscription {
        -db *Database
        +Publisher string
        +PublisherDB string
        +Publication string
        +PublicationType PublicationType
        +Type SubscriptionType
        +Distributor string
        +LastSyncTime time.Time
        +AgentJob string
        merge only: SubscriberType, LastSyncStatus
        +Database() *Database
    }

    class PublicationType {
        <<enumeration>>
        Transactional
        Snapshot
        PeerToPeer
        Merge
    }

    class SubscriptionType {
        <<enumeration>>
        Push
        Pull
        Anonymous
    }

    Server ..> ReplicationInfo : ReplicationInfo
    ReplicationInfo *-- DistributionDatabase
    ReplicationInfo *-- DistributionPublisher
    ReplicationInfo *-- ReplicationDatabase
    Server ..> Publication : LocalPublications
    Database "1" --> "*" Publication : Publications / PublicationByName
    Publication "1" --> "*" Article : Articles
    Article --> SchemaOption
    Publication "1" --> "*" Subscription : Subscriptions
    Server ..> LocalSubscription : LocalSubscriptions
    Database "1" --> "*" LocalSubscription : LocalSubscriptions
    Publication --> PublicationType
    LocalSubscription --> PublicationType
    Subscription --> SubscriptionType
    LocalSubscription --> SubscriptionType
    Server ..> DistributionDatabase : DistributionDatabaseRef
    Server ..> MonitorPublisher : MonitorPublishers
    DistributionDatabase ..> MonitorPublication : MonitorPublications
    DistributionDatabase ..> MonitorSubscription : MonitorSubscriptions
    DistributionDatabase "1" --> "*" ReplicationAgent : Agents
    ReplicationAgent ..> ReplAgentSession : Sessions
    ReplAgentSession ..> ReplAgentAction : SessionActions
    DistributionDatabase ..> ReplicationError : Errors
    ReplicationAgent --> ReplAgentStatus
    MonitorSubscription --> MonitorWarning
